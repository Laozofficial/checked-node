{
  "name": "@checked/node",
  "version": "1.0.0",
  "description": "Check’d production monitoring for Node.js: errors and custom events, with Express, Fastify and AdonisJS helpers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
